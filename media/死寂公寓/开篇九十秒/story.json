    "calm": {
      "speaker": "Uncle_Fu",
      "instruct": "用自然的普通话近距离讲述亲眼看到的事。中低声区，平实克制，语速略紧凑，重音很轻，句尾自然落下。"
    },
    "quiet": {
      "speaker": "Uncle_Fu",
      "instruct": "你在安静的公寓里，贴近听者低声讲述，音量比日常交谈略低，说得清楚而连贯，停顿短，句尾收住，保持朴素的生活语气。"
    },
    "neighbor": {
      "speaker": "Serena",
      "instruct": "你是带着孩子的年轻母亲，怕惊动楼道里的人，隔着门用普通话轻轻求人。自然的轻声和短暂停顿，清楚、克制，紧张藏在气息里。"
    }
  },
