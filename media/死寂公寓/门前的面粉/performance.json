{
  "subs": [
    [
      0.46,
      3.087,
      "楼梯间一响，小旭醒了。"
    ],
    [
      3.087,
      5.172,
      "小美把他拉近。"
    ],
    [
      7.03,
      9.5,
      "妈妈呢？她怎么还不回来？"
    ],
    [
      12.08,
      14.218,
      "快了。马上就回来了。"
    ],
    [
      15.1,
      17.885,
      "这已经是小美第三次这么说。"
    ],
    [
      19.21,
      21.193,
      "她凑近猫眼。"
    ],
    [
      21.193,
      24.4,
      "楼道很暗，还有声音。"
    ],
    [
      24.61,
      27.241,
      "她回头看见那张字条。"
    ],
    [
      27.241,
      30.265,
      "三天后，真的会有救援吗？"
    ],
    [
      31.46,
      33.16,
      "大叔看着监控。"
    ],
    [
      33.16,
      36.02,
      "楼梯口又有影子回来了。"
    ],
    [
      36.29,
      39.44,
      "他看了眼时间。快天亮了。"
    ],
    [
      40.08,
      41.485,
      "早上七点半。"
    ],
    [
      41.485,
      44.013,
      "小宇把门开了一条缝。"
    ],
    [
      44.013,
      47.69,
      "七点三十八分，楼下的闹钟会响。"
    ],
    [
      48.13,
      52.6,
      "水有没有被拿走？他得下去找小美。"
    ],
    [
      53.1,
      54.989,
      "他看了一眼楼梯。"
    ],
    [
      54.989,
      58.769,
      "隔壁的门一直没动静，楼上也静。"
    ],
    [
      59.65,
      62.91,
      "兄弟俩剩下的那个人，还在不在？"
    ],
    [
      63.65,
      69.07,
      "小宇把门虚掩着，轻轻朝楼梯口走了几步。"
    ],
    [
      70.05,
      74.41,
      "他回头看见门口的白面粉，又退回屋里。"
    ],
    [
      74.92,
      78.511,
      "他取了些面粉，撒在隔壁门前。"
    ],
    [
      78.511,
      80.9,
      "把自己门前的擦掉。"
    ],
    [
      85.02,
      88.274,
      "小宇带上门，攥紧钥匙下楼。"
    ]
  ],
