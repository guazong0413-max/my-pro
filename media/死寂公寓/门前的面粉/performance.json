{
  "subs": [
    [
      0.46,
      3.061,
      "楼下的小美一直捂着小旭的嘴。"
    ],
    [
      3.061,
      5.29,
      "楼梯间的吵闹声吵醒孩子。"
    ],
    [
      5.32,
      7.98,
      "小旭害怕地看向外面。"
    ],
    [
      8.07,
      8.924,
      "妈妈呢？"
    ],
    [
      9.23,
      10.741,
      "她怎么还不回来？"
    ],
    [
      11.1,
      12.85,
      "小美看了看小旭。"
    ],
    [
      12.91,
      14.87,
      "快了，马上就回来了。"
    ],
    [
      14.9,
      16.407,
      "这已经是第三次"
    ],
    [
      16.407,
      17.63,
      "和小旭说快了。"
    ],
    [
      17.68,
      18.729,
      "她站起身，"
    ],
    [
      18.729,
      20.31,
      "看向了猫眼外。"
    ],
    [
      20.35,
      22.218,
      "她也听到了刚刚的声音，"
    ],
    [
      22.218,
      24.3,
      "但并不知道外面发生了什么。"
    ],
    [
      24.39,
      25.455,
      "她回过头，"
    ],
    [
      25.455,
      26.89,
      "看向了那张字条。"
    ],
    [
      26.95,
      29.093,
      "到底是不是真的有救援？"
    ],
    [
      29.28,
      31.511,
      "他为什么要告诉自己呢？"
    ],
    [
      31.64,
      33.358,
      "楼上的大叔看着监控。"
    ],
    [
      33.358,
      35.86,
      "楼梯口的丧尸又回到了那里。"
    ],
    [
      35.9,
      37.649,
      "大叔看了一眼时间，"
    ],
    [
      37.649,
      38.842,
      "快到早上了。"
    ],
    [
      39.56,
      41.226,
      "早上七点三十分，"
    ],
    [
      41.226,
      42.772,
      "小宇打开了门缝，"
    ],
    [
      42.772,
      44.18,
      "看了一眼外边。"
    ],
    [
      44.25,
      45.483,
      "楼下的闹铃"
    ],
    [
      45.483,
      48.06,
      "会在七点三十八分响起来。"
    ],
    [
      48.09,
      50.334,
      "他不知道水是否被取走，"
    ],
    [
      50.334,
      51.93,
      "需要下去找小美。"
    ],
    [
      51.98,
      54.51,
      "他透过门缝看了眼楼梯。"
    ],
    [
      54.55,
      57.607,
      "过了这么久，隔壁门始终没有动静，"
    ],
    [
      57.607,
      59.16,
      "楼上也一片安静。"
    ],
    [
      59.19,
      61.212,
      "兄弟剩下的那个人"
    ],
    [
      61.212,
      63.01,
      "不知道是死是活。"
    ],
    [
      63.04,
      64.515,
      "小宇虚掩着门，"
    ],
    [
      64.515,
      66.79,
      "轻轻地朝楼梯口走过去。"
    ],
    [
      66.83,
      69.58,
      "有危险就可以直接退回房间。"
    ],
    [
      69.62,
      71.026,
      "楼道一片寂静。"
    ],
    [
      71.026,
      74.04,
      "他回头看了眼门前的白色面粉。"
    ],
    [
      74.07,
      76.447,
      "回到屋子里，又拿出了一些面粉，"
    ],
    [
      76.447,
      78.23,
      "撒到了兄弟二人的门前。"
    ],
    [
      78.29,
      80.32,
      "把自己门前的面粉清掉。"
    ],
    [
      80.36,
      82.85,
      "这时楼下的闹铃突然响起。"
    ],
    [
      82.9,
      84.65,
      "脚步声向下传去。"
    ],
    [
      85.45,
      87.311,
      "小宇轻轻把门带上，"
    ],
    [
      87.311,
      89.78,
      "攥紧了钥匙，快步走下了楼。"
    ]
  ],
