  "roles": {
    "narrator": {
      "speaker": "Uncle_Fu",
      "instruct": "普通话。像在安静的公寓里，低声讲一件亲眼所见的事。语速连贯自然，重音少，句尾轻轻收住。避免播音腔，大部分句子保持近似音量。"
    },
    "child": {
      "speaker": "Dylan",
      "instruct": "普通话。用偏年轻、轻一点的声线，像孩子在深夜小声问大人。怕惊动门外，紧张但压住声音。第一句问完停一下，后面的问句克制。"
    },
    "mei": {
      "speaker": "Serena",
      "instruct": "普通话。年轻女性在安静的房间里把声音放轻，轻轻安抚身旁的孩子，怕门外听见。第一句短，停顿半拍再轻声说下半句。语气温和含着不安。"
    }
  },
  "lines": [
    {
      "id": "noise",
      "at": 0.46,
      "until": 5.65,
      "text": "楼梯间一响，小旭醒了。小美把他拉近。",
      "role": "narrator",
      "subs": [
        "楼梯间一响，小旭醒了。",
        "小美把他拉近。"
      ],
      "seed": 14101
    },
    {
      "id": "mother",
      "at": 7.03,
      "until": 11.12,
      "text": "妈妈呢？她怎么还不回来？",
      "role": "child",
      "subs": [
        "妈妈呢？她怎么还不回来？"
      ],
      "seed": 13722
    },
    {
      "id": "soon",
      "at": 12.08,
      "until": 14.72,
      "text": "快了。马上就回来了。",
      "role": "mei",
      "subs": [
        "快了。马上就回来了。"
      ],
      "seed": 13723
    },
    {
      "id": "again",
      "at": 15.1,
      "until": 18.77,
      "text": "这已经是小美第三次这么说。",
      "role": "narrator",
      "subs": [
        "这已经是小美第三次这么说。"
      ],
      "seed": 13724
    },
    {
      "id": "peek",
      "at": 19.21,
      "until": 24.4,
      "text": "她凑近猫眼。楼道很暗，还有声音。",
      "role": "narrator",
      "subs": [
        "她凑近猫眼。",
        "楼道很暗，还有声音。"
      ],
      "seed": 14102
    },
    {
      "id": "note",
      "at": 24.61,
      "until": 30.48,
      "text": "她回头看见那张字条。三天后，真的会有救援吗？",
      "role": "narrator",
      "subs": [
        "她回头看见那张字条。",
        "三天后，真的会有救援吗？"
      ],
      "seed": 13726
    },
    {
      "id": "monitor",
      "at": 31.46,
      "until": 36.02,
      "text": "大叔看着监控。楼梯口又有影子回来了。",
      "role": "narrator",
      "subs": [
        "大叔看着监控。",
        "楼梯口又有影子回来了。"
      ],
      "seed": 14103
    },
    {
      "id": "dawn",
      "at": 36.29,
      "until": 39.44,
      "text": "他看了眼时间。快天亮了。",
      "role": "narrator",
      "subs": [
        "他看了眼时间。快天亮了。"
      ],
      "seed": 14104
    },
    {
      "id": "morning",
      "at": 40.08,
      "until": 47.69,
      "text": "早上七点半。小宇把门开了一条缝。七点三十八分，楼下的闹钟会响。",
      "role": "narrator",
      "subs": [
        "早上七点半。",
        "小宇把门开了一条缝。",
        "七点三十八分，楼下的闹钟会响。"
      ],
      "seed": 13729
    },
    {
      "id": "water",
      "at": 48.13,
      "until": 52.6,
      "text": "水有没有被拿走？他得下去找小美。",
      "role": "narrator",
      "subs": [
        "水有没有被拿走？他得下去找小美。"
      ],
      "seed": 13730
    },
    {
      "id": "quiet",
      "at": 53.1,
      "until": 59.18,
      "text": "他看了一眼楼梯。隔壁的门一直没动静，楼上也静。",
      "role": "narrator",
      "subs": [
        "他看了一眼楼梯。",
        "隔壁的门一直没动静，楼上也静。"
      ],
      "seed": 13731
    },
    {
      "id": "neighbor",
      "at": 59.65,
      "until": 63.07,
      "text": "兄弟俩剩下的那个人，还在不在？",
      "role": "narrator",
      "subs": [
        "兄弟俩剩下的那个人，还在不在？"
      ],
      "seed": 13732
    },
    {
      "id": "steps",
      "at": 63.65,
      "until": 69.07,
      "text": "小宇把门虚掩着，轻轻朝楼梯口走了几步。",
      "role": "narrator",
      "subs": [
        "小宇把门虚掩着，轻轻朝楼梯口走了几步。"
      ],
      "seed": 13733
    },
    {
      "id": "flour",
      "at": 70.05,
      "until": 74.41,
      "text": "他回头看见门口的白面粉，又退回屋里。",
      "role": "narrator",
      "subs": [
        "他回头看见门口的白面粉，又退回屋里。"
      ],
      "seed": 13734
    },
    {
      "id": "switch",
      "at": 74.92,
      "until": 80.9,
      "text": "他取了些面粉，撒在隔壁门前，把自己门前的擦掉。",
      "role": "narrator",
      "subs": [
        "他取了些面粉，撒在隔壁门前。",
        "把自己门前的擦掉。"
      ],
      "seed": 13735
    },
    {
      "id": "key",
      "at": 85.02,
      "until": 89.45,
      "text": "小宇带上门，攥紧钥匙下楼。",
      "role": "narrator",
      "subs": [
