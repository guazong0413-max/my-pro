{
  "subs": [
    [
      0.5,
      3.006,
      "凌晨，两点十七分。"
    ],
    [
      3.8,
      6.425,
      "陈默，是被手机震醒的。"
    ],
    [
      8.44,
      9.405,
      "紧急通知。"
    ],
    [
      9.405,
      12.641,
      "请全体市民关闭门窗，切勿外出。"
    ],
    [
      13.69,
      14.801,
      "什么情况？"
    ],
    [
      15.01,
      18.23,
      "他没有开灯，赤着脚走到窗边。"
    ],
    [
      18.4,
      20.526,
      "黑夜里，一扇亮着的窗，"
    ],
    [
      20.526,
      22.44,
      "几百米外都看得见。"
    ],
    [
      22.84,
      25.107,
      "窗外，警灯拖着残影。"
    ],
    [
      25.107,
      26.88,
      "而对面楼的护栏外，"
    ],
    [
      27.02,
      28.436,
      "站着一个人。"
    ],
    [
      30.4,
      33.42,
      "下一秒，那个人松开了手。"
    ],
    [
      35.95,
      38.252,
      "重重砸进楼下的花坛。"
    ],
    [
      39.3,
      42.0,
      "十几米的高度，正常人，"
    ],
    [
      42.0,
      43.85,
      "不可能活下来。"
    ],
    [
      44.78,
      46.034,
      "可三秒后，"
    ],
    [
      46.67,
      49.291,
      "那具本该摔断筋骨的身体"
    ],
    [
      49.47,
      50.564,
      "扭曲着四肢，"
    ],
    [
      50.564,
      53.42,
      "以完全违背人体结构的姿势，"
    ],
    [
      53.48,
      55.545,
      "缓缓撑了起来。"
    ],
    [
      56.34,
      58.248,
      "他猛地松开窗帘，"
    ],
    [
      58.248,
      60.801,
      "后背抵上冰冷的墙面。"
    ],
    [
      61.2,
      64.22,
      "窗外的雨，好像突然变大了。"
    ],
    [
      64.35,
      64.898,
      "不对。"
    ],
    [
      65.48,
      68.13,
      "这绝不是普通的治安事件。"
    ],
    [
      68.8,
      71.491,
      "他没有开灯，也没有出声。"
    ],
    [
      72.29,
      75.74,
      "在未知的危险面前，先藏好自己。"
    ],
    [
      75.98,
      78.49,
      "永远是活下去的第一步。"
    ],
    [
      81.16,
      84.026,
      "而这，只是第一夜。"
    ]
  ],
