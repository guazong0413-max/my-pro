{
  "subs": [
    [
      0.22,
      2.389,
      "凌晨，两点十七分。"
    ],
    [
      3.7,
      5.995,
      "陈默，是被手机震醒的。"
    ],
    [
      8.44,
      9.405,
      "紧急通知。"
    ],
    [
      9.405,
      12.641,
      "请全体市民关闭门窗，切勿外出。"
    ],
    [
      13.69,
      14.801,
      "什么情况？"
    ],
    [
      15.01,
      18.12,
      "他没有开灯，赤着脚走到窗边。"
    ],
    [
      18.14,
      20.342,
      "黑夜里，一扇亮着的窗，"
    ],
    [
      20.342,
      22.268,
      "几百米外都看得见。"
    ],
    [
      22.63,
      24.89,
      "窗外，警灯拖着残影。"
    ],
    [
      24.89,
      26.931,
      "而对面楼的护栏外，"
    ],
    [
      27.1,
      28.047,
      "站着一个人。"
    ],
    [
      29.91,
      32.338,
      "下一秒，那个人松开了手。"
    ],
    [
      35.95,
      37.615,
      "重重砸进楼下的花坛。"
    ],
    [
      39.3,
      41.581,
      "十几米的高度，正常人，"
    ],
    [
      41.581,
      43.035,
      "不可能活下来。"
    ],
    [
      44.78,
      45.695,
      "可三秒后，"
    ],
    [
      46.67,
      48.568,
      "那具本该摔断筋骨的身体"
    ],
    [
      49.47,
      50.474,
      "扭曲着四肢，"
    ],
    [
      50.474,
      52.78,
      "以完全违背人体结构的姿势，"
    ],
    [
      53.48,
      54.645,
      "缓缓撑了起来。"
    ],
    [
      56.34,
      57.751,
      "他猛地松开窗帘，"
    ],
    [
      57.751,
      59.665,
      "后背抵上冰冷的墙面。"
    ],
    [
      60.73,
      63.153,
      "窗外的雨，好像突然变大了。"
    ],
    [
      64.35,
      64.898,
      "不对。"
    ],
    [
      65.48,
      67.118,
      "这绝不是普通的治安事件。"
    ],
    [
      68.66,
      71.097,
      "他没有开灯，也没有出声。"
    ],
    [
      72.12,
      74.955,
      "在未知的危险面前，先藏好自己。"
    ],
    [
      75.74,
      77.276,
      "永远是活下去的第一步。"
    ],
    [
      81.1,
      83.185,
      "而这，只是第一夜。"
    ]
  ],
